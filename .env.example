# Copy to .env and fill in. Never commit .env.
# Provider: gemini | groq | xai (or grok) | openai | anthropic (or claude) | openrouter | mistral | deepseek | ollama | custom
LLM_PROVIDER=gemini
LLM_API_KEY=
# Optional: model name (each provider has a built-in default)
LLM_MODEL=
# Only for provider=custom (any OpenAI-compatible endpoint, e.g. https://host/v1)
LLM_BASE_URL=
# Optional tuning
# LLM_TIMEOUT=120
# LLM_TEMPERATURE=0
# AGENT_KEEP_FULL=6
# Reasoning effort for models that support it (e.g. Gemini 3.x via the OpenAI-compatible API): low | medium | high
# LLM_REASONING_EFFORT=medium
# Self-review round after the first report (default on). Set to 0 to disable.
# AGENT_REVIEW=1
